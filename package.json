{
  "name": "teko",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Teko: orquestrador de IA aberto e seguro, com módulos de carreira e finanças.",
  "author": "Felipe Oliveira",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w @teko/app",
    "dev": "turbo run dev",
    "mcp": "npm run mcp -w @teko/app",
    "discover:projects": "npm run discover:projects -w @teko/app --",
    "reset": "npm run reset -w @teko/ai",
    "index": "npm run index -w @teko/ai",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mapa",
  "description": "A janela do mapa (servida pelo Teko local) ouve eventos do app e só pode chamar o comando de fechar o mapa.",
  "windows": [
    "context-map"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:4780/*",
      "http://localhost:4780/*"
    ]
  },
  "permissions": [
    "core:event:default",
    "allow-close-context-map"
  ]
}

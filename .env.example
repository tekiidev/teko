# Copie para .env e preencha só o que você usa.
# As chaves também podem ser cadastradas pela aba "Conexões" do dashboard
# (ficam no SQLite local, em data/orquestrador.db).

PORT=4780

# Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Ollama local (não precisa de chave)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Google Drive / Docs (OAuth client do tipo "Desktop app")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Figma (Personal Access Token, escopo de leitura de arquivo)
FIGMA_TOKEN=
